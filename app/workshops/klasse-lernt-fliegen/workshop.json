      {
        "id": "7bc82974-e6e5-426a-bd79-358886dd9fa1",
        "kind": "instructions",
        "title": "Anleitung",
        "fields": {},
        "subsections": [
          {
            "id": "278a6d54-7a4b-4982-bd75-fbb1d2d85b99",
            "kind": "intro",
            "title": "Einführung",
            "blocks": [
              {
                "id": "ddf0ceac-b0b9-432c-8975-2913127a16e0",
                "type": "text",
                "text": "Warum fliegen Flugzeuge und Vögel? Wie halten Strömungen schwere Objekte in der Luft? In diesem Schülerlabor erforschen Schulklassen die physikalischen Grundlagen der Aerodynamik und treten in Teams an, um aus einfachen Materialien gleitfähige und reichweitenstarke Flugmodelle zu entwickeln."
              }
            ]
          },
          {
            "id": "bc573f31-34c7-4946-bbb5-2791cd8fb7b3",
            "kind": "schedule",
            "title": "Ablauf",
            "blocks": [
              {
                "id": "64b8f409-f3ef-4532-b12d-8cde6923b76d",
                "type": "phases",
                "phases": [
                  {
                    "title": "Das Geheimnis des Auftriebs",
                    "steps": [
                      {
                        "title": "Grundlagen & Experimente",
                        "duration": "45 Minuten",
                        "description": "Experimenteller Einstieg in Bernoulli-Effekt, Tragflächenprofile, Gravitation und Luftwiderstand.",
                        "method": "Mitmach-Experimente & Strömungssimulation"
                      }
                    ]
                  },
                  {
                    "title": "Prototyping & Bauwerkstatt",
                    "steps": [
                      {
                        "title": "Konstruktion der Gleiter",
                        "duration": "75 Minuten",
                        "description": "Konstruktion verschiedener Fluggleiter in Kleingruppen unter Berücksichtigung von Schwerpunkt, Gewicht und Flügelgeometrie.",
                        "method": "Rapid Prototyping & Konstruktionswerkstatt"
                      }
                    ]
                  },
                  {
                    "title": "Der große Flugtest",
                    "steps": [
                      {
                        "title": "Testflüge & Optimierung",
                        "duration": "60 Minuten",
                        "description": "Erprobung auf der Teststrecke, Messung von Flugweite und Gleitwinkel sowie iterative Modifikation der Modelle.",
                        "method": "Messreihe, Testläufe & iteratives Feintuning"
                      }
                    ]
                  },
                  {
                    "title": "Siegerehrung & MINT-Reflexion",
                    "steps": [
                      {
                        "title": "Auswertung & Siegerehrung",
                        "duration": "45 Minuten",
                        "description": "Auswertung der Konstruktionsdaten, Prämierung der besten Teamergebnisse und Transfer zur modernen Luftfahrttechnologie.",
                        "method": "Ergebnispräsentation & Siegerehrung"
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
