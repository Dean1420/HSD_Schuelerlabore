        {
            "id": "813feab1-b5db-429f-8e9d-fdebee17f8de",
            "kind": "instructions",
            "title": "Anleitung",
            "fields": {},
            "subsections": [
                {
                    "id": "6216b34e-9ef7-457c-8256-92a8b0ed5e47",
                    "kind": "intro",
                    "title": "Einführung",
                    "blocks": [
                        {
                            "id": "46a70c99-dc46-424d-8571-be7e51e2e1f4",
                            "type": "text",
                            "text": "Die Tiere des Waldes stehen vor einer großen Entscheidung: Wer vertritt künftig ihre gemeinsamen Interessen? Anhand eines fabelhaften Rollenspiels erproben die Schüler*innen, wie Meinungen gebildet, Wahlprogramme formuliert und demokratische Wahlen fair ausgetragen werden."
                        }
                    ]
                },
                {
                    "id": "3ecc1c15-94fa-43b6-bfec-0d39d028b327",
                    "kind": "schedule",
                    "title": "Ablauf",
