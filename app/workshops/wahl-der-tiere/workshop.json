                                            "method": ""
                                        }
                                    ]
                                },
                                {
                                    "title": "Diskurs",
                                    "steps": [
                                        {
                                            "title": "",
                                            "duration": "60 Minuten",
                                            "description": "Wahlkampf & Elefantenrunde (Öffentliche Debatte, Koalitionssuche).",
                                            "method": ""
                                        }
                                    ]
                                },
                                {
                                    "title": "Praxis",
                                    "steps": [
                                        {
                                            "title": "",
                                            "duration": "30 Minuten",
                                            "description": "Geheime Wahl & Stimmauszählung (Wahlkabine, Urne, Zählung).",
                                            "method": ""
                                        }
                                    ]
                                },
                                {
