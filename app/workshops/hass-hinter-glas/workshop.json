      {
        "id": "c16ebafa-a561-4e46-9600-69ad21dbecb5",
        "kind": "instructions",
        "title": "Anleitung",
        "fields": {},
        "subsections": [
          {
            "id": "d999695a-e514-45af-bfa3-3a41b526533f",
            "kind": "intro",
            "title": "Einführung",
            "blocks": [
              {
                "id": "4ade2381-f131-4824-94f8-f0f8cd3fdbc7",
                "type": "text",
                "text": "Wie begegnen wir digitaler Gewalt, Diskriminierung und Hasskommentaren im Netz? In diesem Schülerlabor analysieren die Teilnehmenden sprachliche Mechanismen von Hate Speech und lernen, wie Design, Illustration und pointierte Typografie als wirksame Instrumente der Gegenrede und Haltung eingesetzt werden können."
              }
            ]
          },
          {
            "id": "dac16d52-129f-4029-937c-9408ad7d8c73",
            "kind": "schedule",
            "title": "Ablauf",
            "blocks": [
              {
                "id": "08474962-c838-4676-8ec3-53245e89adeb",
                "type": "phases",
                "phases": [
                  {
                    "title": "Hetze im Netz dechiffrieren",
                    "steps": [
                      {
                        "title": "Analyse realer Fallbeispiele",
                        "duration": "45 Minuten",
                        "description": "Analyse realer Fallbeispiele: Wie funktioniert Hate Speech, welche rechtlichen Grenzen gibt es und was bewirkt sie bei Betroffenen?",
                        "method": "Fallbeispiele-Analyse & Ampelabfrage"
                      }
                    ]
                  },
                  {
                    "title": "Visuelle Gegenrede & Konzept",
                    "steps": [
                      {
                        "title": "Ideenfindung & Konzeption",
                        "duration": "75 Minuten",
                        "description": "Ideenfindung und Konzeption pointierter Gegennarrative, Plakate oder Memes für digitale Zivilcourage.",
                        "method": "Mind-Mapping, Slogan-Entwicklung & Scribble-Werkstatt"
                      }
                    ]
                  },
                  {
                    "title": "Gestalterische Umsetzung",
                    "steps": [
                      {
                        "title": "Illustrative Werkstatt",
                        "duration": "60 Minuten",
                        "description": "Reinzeichnung der Entwürfe wahlweise analog (Marker, Gouache, Collagen) oder digital (Tablets).",
                        "method": "Illustrative Atelierarbeit & Feedback-Schleifen"
                      }
                    ]
                  },
                  {
                    "title": "Die Ausstellung hinter Glas",
                    "steps": [
                      {
                        "title": "Kuration & Reflexion",
                        "duration": "45 Minuten",
                        "description": "Präsentation der Arbeiten im Glas- und Galerierahmen sowie Ableitung konkreter Verhaltensregeln für den eigenen Klassen-Chat.",
                        "method": "Gallery Walk, Kuration & Netiquette-Vereinbarung"
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
